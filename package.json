{
  "name": "hydrabit",
  "version": "0.1.0",
  "description": "A tiny pixel desktop widget for water and supplement micro-habits.",
  "main": "out/main/index.js",
  "author": "HydraBit",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.5",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "build": {
    "appId": "app.hydrabit.desktop",
    "productName": "HydraBit",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
